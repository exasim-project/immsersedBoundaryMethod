+// * * * * * * * * * * * * Protected Member Functions  * * * * * * * * * * * //
+
+void Foam::vofIndicator::addLayers()
+{
+    if(addLayers_ == 0) return;
+
+    dynamicFvMesh& mesh = foam_.mesh;
+    bitSet layers(mesh.nCells(), false);
+
+    volScalarField grad("gradVofIndicator", mag(fvc::grad(field_)));
+    scalar maxGrad = max(grad).value();
+
+    forAll(grad, celli)
+    {
+        if(grad[celli]/maxGrad > 0.01) layers[celli] = true;
+    }
+
+    for(int i = 1; i < mag(addLayers_); i++) extendMarkedCells(layers);
+    
+    scalar indicatorValue = 1.0;
+    if(addLayers_ < 0) indicatorValue = 0.0; //if addLayers in negative, set cells to 0
+
+    forAll(layers, celli)
+    {
+        if(layers.test(celli)) field_[celli] = indicatorValue;
+    }
+}
+
+void Foam::vofIndicator::extendMarkedCells
+(
+    bitSet& markedCell
+)
+{
+    dynamicFvMesh& mesh = foam_.mesh;
+    bitSet markedFace(mesh.nFaces());
+
+    for (const label celli : markedCell)
+    {
+        markedFace.set(mesh.cells()[celli]); 
+    }
+    //syncTools::syncFaceList(mesh, markedFace, orEqOp<unsigned int>());
+
+    // Update cells using any markedFace
+    for (label facei = 0; facei < mesh.nInternalFaces(); ++facei)
+    {
+        if( markedFace.test(facei) )
+        {
+            const label& ownI = mesh.faceOwner()[facei];
+            const label& neiI = mesh.faceNeighbour()[facei];
+            markedCell.set(ownI);
+            markedCell.set(neiI);
+        }
+    }
+    for (label facei = mesh.nInternalFaces(); facei < mesh.nFaces(); ++facei)
+    {
+        const label& celli = mesh.faceOwner()[facei];
+        if 
+        (
+            markedFace.test(facei) 
+        )
+        {   
+            markedCell.set(celli);
+        }
+    }
+}
+
+// * * * * * * * * * * * * * * * * Constructors  * * * * * * * * * * * * * * //
+Foam::vofIndicator::vofIndicator
+(
+    const word name,
+    dynamicFvMesh& mesh
+)
+:
+  timeDependent(name, mesh),
+  alpha_(dict_.get<word>("alpha")),
+  makeBinary_(dict_.found("threshold")),
+  threshold_(dict_.getOrDefault<scalar>("threshold", -1)),
+  addLayers_(dict_.get<label>("addLayers"))
+{  
+    update();
+}
+
+// * * * * * * * * * * * * * * * * Destructor  * * * * * * * * * * * * * * * //
+Foam::vofIndicator::~vofIndicator(){}
+
+// * * * * * * * * * * * * * * Member Functions  * * * * * * * * * * * * * * //
+
+void Foam::vofIndicator::update()
+{
+    volScalarField& alpha = foam_.loadField<scalar>(alpha_);
+
+    if(makeBinary_)
+    {
+        field_ = pos(alpha-threshold_);
+        addLayers();
+    }
+    else
+    {
+        field_ = max(0.0, min(1.0, alpha));
+    }
+    field_.correctBoundaryConditions();
+}
