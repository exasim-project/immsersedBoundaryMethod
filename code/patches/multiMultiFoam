+
+template<class Type>
+Switch Foam::linearReaction<Type>::update()
+{
+  foamTools& foam = this->foam_;
+
+  if(foam.runTime.timeIndex() == timeIndex_){ return false; }
+  timeIndex_ = foam.runTime.timeIndex();
+  
+  const List<word> s = species_.toc();
+
+  if(foam.meshUpdated()){ reactionRatePtr_.clear(); }
+
+  forAll(s, sID)
+  {
+    if(species_[s[sID]] < 0)
+    {
+      volScalarField field(foam.loadField<scalar>(s[sID]));
+      field = max(field, 1e-04*cRef_);
+
+      if(!reactionRatePtr_.valid())
+      {
+        reactionRatePtr_.reset
+        (
+          new volScalarField
+          (
+            r0_*pow(field/cRef_, -species_[s[sID]])
+          )
+        );
+        continue;
+      }
+      reactionRatePtr_.ref() *= pow(field/cRef_, -species_[s[sID]]);
+    }
+  }
+  reactionRatePtr_.ref() = max(reactionRatePtr_.ref(), 0*r0_);
+  return true;
+}
+
+// * * * * * * * * * * * * * * * * Constructors  * * * * * * * * * * * * * * //
+
+template<class Type>
+Foam::linearReaction<Type>::linearReaction
+(
+  
+  const word name, 
+  dynamicFvMesh& mesh
+)
+:
+ofTerm<Type>(name, mesh),
+timeIndex_(-1)
+{
+  const dictionary& dict = this->dict_;
+
+  species_ = dict.get<HashTable<label>>("species");
+
+  r0_.dimensions().reset(dict.get<dimensionedScalar>("r0").dimensions());
+  cRef_.dimensions().reset(dict.get<dimensionedScalar>("cRef").dimensions());
+  r0_ = dict.get<dimensionedScalar>("r0");
+  cRef_ = dict.get<dimensionedScalar>("cRef");
+}
+
+// * * * * * * * * * * * * * * * * Destructor  * * * * * * * * * * * * * * * //
+
+template<class Type>
+Foam::linearReaction<Type>::~linearReaction()
+{}
+
+// * * * * * * * * * * * * * * Member Functions  * * * * * * * * * * * * * * //
+template<class Type>
+void Foam::linearReaction<Type>::matrix(fvMatrix<Type>& Eqn, const word equationName)
+{  
+  update();
+
+  Eqn -= species_[Eqn.psi().name()] * reactionRatePtr_.ref();
+
+
+  if(Eqn.psi().mesh().time().outputTime())
+  {
+    reactionRatePtr_.ref().rename(this->name_ + "Rate");
+    reactionRatePtr_.ref().write();
+  }
+}
