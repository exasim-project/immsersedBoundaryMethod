+class rhoCpFlux:public massFlux
+{
+  private:
+
+  protected:
+    const dimensionedScalar cp1_;
+    const dimensionedScalar cp2_;
+    const dimensionedScalar rho1_;
+    const dimensionedScalar rho2_;
+    const volScalarField& alpha1_;
+
+  public:
+    //- Runtime type information
+    TypeName("rhoCpFlux");
+
+    //- Construct from name and a dictionary
+    rhoCpFlux
+    (
+      const word name, 
+      dynamicFvMesh& mesh
+    );
+
+    //- Destructor
+    virtual ~rhoCpFlux();
+
+    // Member Functions
+    virtual tmp<surfaceScalarField> convective(){
+      return fieldCoeffs::convective()*fvc::interpolate(rho1_ * cp1_*alpha1_ + rho2_ * cp2_ * (1.0 - alpha1_)); }
+
+    virtual tmp<volScalarField> transient(){ return (rho1_ * cp1_ * alpha1_ + rho2_ * cp2_ * (1.0 - alpha1_)); }
+
+    virtual dimensionSet dimensions(){ return fieldCoeffs::dimensions()*rho1_.dimensions()*cp1_.dimensions(); }
+};
+
