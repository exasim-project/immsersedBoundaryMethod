+bool Foam::composedAdaptCriteria::updated()
+{
+    const label& curTimeIndex = mesh_.time().timeIndex();
+    if(timeIndex_ == curTimeIndex){return true;}
+    timeIndex_ = curTimeIndex;
+    return false;
+}
+
+void Foam::composedAdaptCriteria::update()
+{
+    if(updated()){return;}
+
+    const labelIOList& curCellLevel = mesh().lookupObject<labelIOList>("cellLevel");
+    List<bitSet> curProtectedCells(criteriaSelections_.size());
+    protectedCells_ = bitSet(mesh().nCells(),false);
+
+    forAll(criteriaSelections_, brsI)
+    {
+        curProtectedCells[brsI] = criteriaSelections_[brsI].protectedCells();
+
+        for (const label celli : curProtectedCells[brsI])
+        {
+            if(curCellLevel[celli] > maxCellLevels_[brsI]){ curProtectedCells[brsI].unset(celli); }
+        }
+
+        if(brsI == 0){ protectedCells_ = curProtectedCells[brsI]; }
+        else
+        {
+            switch (operation_)
+            {
+                case opOr:{ protectedCells_ = protectedCells_ | curProtectedCells[brsI]; break; }
+                case opAnd:{ protectedCells_ = protectedCells_ & curProtectedCells[brsI]; break; }
+                case opXor:{ protectedCells_ = protectedCells_ ^ curProtectedCells[brsI]; break; }
+                default:{ FatalErrorInFunction << "operation not available" << endl; break;}
+            }
+        }
+    }
+
+    //update refinement cells (all cells that match the refinement-criterion and are not at max level)
+    refinementCellCandidates_ = bitSet(mesh().nCells(),false);
+    
+    for (const label celli : protectedCells_)
+    {
+        forAll(criteriaSelections_, brsI)
+        {
+            if
+            ( 
+                curCellLevel[celli] < maxCellLevels_[brsI] &&
+                curProtectedCells[brsI][celli]
+            ){ 
+                refinementCellCandidates_.set(celli); break;
+            }
+        }
+    }
+    if(negate_){refinementCellCandidates_ = ~refinementCellCandidates_;}
+
+    //update unrefinement cells (all cells that do not match the refinement-criterion)
+    unrefinementPointCandidates_ = bitSet(mesh().nPoints(),true);
+
+    forAll (criteriaSelections_, brsI)
+    {
+        const bitSet curUnRefCandidates(criteriaSelections_[brsI].unrefinementPointCandidates());
+
+        if(brsI == 0){ unrefinementPointCandidates_ = curUnRefCandidates;}
+        else
+        {
+            switch (operation_)
+            {
+                case opOr:{ unrefinementPointCandidates_ = unrefinementPointCandidates_ | curUnRefCandidates; break; }
+                case opAnd:{ unrefinementPointCandidates_ = unrefinementPointCandidates_ & curUnRefCandidates; break; }
+                case opXor:{ unrefinementPointCandidates_ = unrefinementPointCandidates_ ^ curUnRefCandidates; break; }
+                default:{ FatalErrorInFunction << "operation not available" << endl; break;}
+            }
+        }
+    }
+}
+
