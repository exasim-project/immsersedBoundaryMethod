+void Foam::dynamicMultiDimRefineBalancedFvMesh::findCoarseCells
+(
+    List<label>& cells, 
+    bitSet& searchedCells, 
+    const label cellI, 
+    const label topParentI
+)
+{
+    const labelList& uniqueIndex = uniqueIndexPtr_();
+    searchedCells.set(cellI);
+    if(uniqueIndex[cellI] != topParentI){return; }
+
+    if(!cells.found(cellI)){ cells.append(cellI); }
+
+    // the cell has the same parent as cellI
+    const List<label>& neighbourCells = this->cellCells()[cellI];
+    forAll(neighbourCells, nID)
+    {
+        const label& nCellI = neighbourCells[nID];
+        if(!searchedCells.test(nCellI)){ findCoarseCells(cells, searchedCells, nCellI, topParentI); }
+    }
+}
+
+Foam::List<Foam::label> Foam::dynamicMultiDimRefineBalancedFvMesh::getUniqueIndicies(const label& cellI)
+{
+    const labelList& uniqueIndex = uniqueIndexPtr_();
+
+    List<label> cCells(1, cellI);
+    bitSet searchedCells(nCells(), false);
+    
+    if(meshCutter()->cellLevel()[cellI] > 0)
+    {
+        findCoarseCells(cCells, searchedCells, cellI, uniqueIndex[cellI]);
+    }//cells should contain all cell-ID of the cells with the same topParentI
+
+    List<label> coupledCells(0);
+    forAll(cCells, cID)
+    {
+        const label& cCellI = cCells[cID];
+        const List<label> testCoupled = getCoupledCells(cCellI);
+
+        if(testCoupled.size() > coupledCells.size())
+        {
+            coupledCells = testCoupled;
+        }
+    }
+    return coupledCells;
+}
+
+Foam::List<Foam::label> Foam::dynamicMultiDimRefineBalancedFvMesh::getCoupledCells(const label& cellI)
+{
+    const labelList& uniqueIndex = uniqueIndexPtr_();
+
+    const labelList& faces = cells()[cellI];
+    List<label> indices(0);
+
+    forAll(faces, i)
+    {
+        const label& faceI = faces[i];
+
+        // This gives you the patch ID for a face. If the face is internal, you get -1
+        const label patchID = boundaryMesh().whichPatch(faceI);
+
+        if(patchID > -1)
+        {
+            const polyPatch& pp = boundaryMesh()[patchID];
+
+            if (isA<cyclicPolyPatch>(pp))
+            {
+                const cyclicPolyPatch& cpp = static_cast<const cyclicPolyPatch&>(pp);
+                const label neighbour = cpp.neighbPatch().faceCells()[cpp.whichFace(faceI)];
+
+                indices.append(uniqueIndex[neighbour]);
+            }
+        }
+    }
+    return indices;
+}
