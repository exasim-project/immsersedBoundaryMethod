+bool Foam::fieldBounds::extendMarkedCells
+(
+    bitSet& markedCell,
+    const labelIOList& curCellLevel
+)
+{
+    //To avoid too many cells being refined, extending is stoped after a cell which is not at max. level is found
+    Switch stop = false;
+    bitSet markedFace(mesh_.nFaces());
 
-    if(negate_)
+    for (const label celli : markedCell)
     {
-        unrefinePoints = ~unrefinePoints;
+        markedFace.set(mesh_.cells()[celli]);  // set multiple faces
+        if(curCellLevel[celli] < maxCellLevel_){ stop=true; }
     }
+    syncTools::syncFaceList(mesh_, markedFace, orEqOp<unsigned int>());
+
+    // Update cells using any markedFace
+    for (label facei = 0; facei < mesh_.nInternalFaces(); ++facei)
+    {
+        if( markedFace.test(facei) )
+        {
+            const label& ownI = mesh_.faceOwner()[facei];
+            const label& neiI = mesh_.faceNeighbour()[facei];
+            markedCell.set(ownI);
+            markedCell.set(neiI);
 
-    return unrefinePoints;
+            if(curCellLevel[ownI] < maxCellLevel_){stop=true;}
+            if(curCellLevel[neiI] < maxCellLevel_){stop=true;}
+        }
+    }
+    for (label facei = mesh_.nInternalFaces(); facei < mesh_.nFaces(); ++facei)
+    {
+        const label& celli = mesh_.faceOwner()[facei];
+        if 
+        (
+            markedFace.test(facei) 
+        )
+        {   
+            markedCell.set(celli);
+            if(curCellLevel[celli] < maxCellLevel_){stop=true;}
+        }
+    }
+    return stop;
 }
 
