FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//dimensions      [0 2 -2 0 0 0 0]; // for volumeFlux
dimensions      [1 -1 -2 0 0 0 0]; // for mass flux


internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            cyclic;
   }

    outlet
    {
        type            cyclic;
    }

    upperWall
    {
        type            zeroGradient;
    }

    lowerWall
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}


