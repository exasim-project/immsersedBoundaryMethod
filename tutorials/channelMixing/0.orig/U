FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../parameter"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($Ux 0 0);

boundaryField
{
    inlet
    {
        type           cyclic;
    }

    outlet
    {
        type            cyclic; 
    }

    upperWall
    {
        type            noSlip;
    }

    lowerWall
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}


