FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../parameter"

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform $rho_electrolyte;

boundaryField
{
    inlet
    {
        type            cyclic;
   }

    outlet
    {
        type            cyclic;
    }

    upperWall
    {
        type            zeroGradient;
    }

    lowerWall
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}


