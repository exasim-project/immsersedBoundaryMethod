FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      hydrogen;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0]; // molar concentration [mol / m^3]

internalField   uniform 1;

boundaryField
{
    lowerWall
    {
        type            fixedValue;   
        value           uniform 1; 
    }

    upperWall
    { 
        type            fixedValue;   
        value           uniform 0; 
    }

    "inlet|outlet"
    {
        type            cyclic;
    }

    frontAndBack
    {
        type            empty;
    }
}


