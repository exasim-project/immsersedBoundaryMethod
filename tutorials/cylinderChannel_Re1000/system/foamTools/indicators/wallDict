FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      imageDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

x_min          0.0;
x_max          5.0;
y_min          0.0;
y_max          1.0;
z_min          0.0;
z_max          0.1;

solidThickness  0.1;
upperSolidBoundary  0.9;
lowerSolidBoundary  0.1;
solidStart     -0.5;

/*------------------------ basic indicator settings --------------------------*/

type                  sector;

actions
(
    {
        source      boxToCell;
        name        lowerSolid;
        action      new;
        sourceInfo
        {
            box     ($solidStart $y_min $z_min)($x_max $lowerSolidBoundary $z_max);
        }
    }
    {
        source      boxToCell;
        name        upperSolid;
        action      add;
        sourceInfo
        {
            box     ($solidStart $upperSolidBoundary $z_min)($x_max $y_max $z_max);
        }
    }
);


