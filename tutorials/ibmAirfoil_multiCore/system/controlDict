FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pisoFoam;
cfdFunctions    (flow);

libs
(
    // "dynamicLoadBalanceFvMesh"
    "soIBM"
    "libVoF"
);

geometry        naca0006;

startFrom       startTime; //latestTime;

startTime       0;

stopAt          endTime;

endTime         100000;

deltaT          1;

writeControl    adjustableRunTime;

writeInterval   5000;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

//maxCo           0.5;

functions
{
    #include "fieldAverage"
    //#include "codedFunctions"
}


