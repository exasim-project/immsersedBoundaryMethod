FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh   dynamicMultiDimRefineFvMesh;

enableBalancing true;
allowableImbalance 0.10;

adaptCriteria
{
    type composedAdaptCriteria;
    operation or;
    criteria
    (    
        gradUCoarse
        {
            type            fieldBounds;
            fieldName       gradU;
            lowerBound      0.25;
            upperBound      1e06;
            maxCellLevel    1;
            nLayer          4;
        }

        gradU
        {
            type            fieldBounds;
            fieldName       gradU;
            lowerBound      0.5;
            upperBound      1e06;
            maxCellLevel    2;
            nLayer          4;
        }

        gradUFine
        {
            type            fieldBounds;
            fieldName       gradU;
            lowerBound      1.0;
            upperBound      1e06;
            maxCellLevel    3;
            nLayer          1;
        }

        wall
        {
            type            fieldBounds;
            fieldName       wallSurface;
            lowerBound      0.01;
            upperBound      0.99;
            maxCellLevel    3;
            nLayer          2;
        }
    );
}
// How often to refine
refineInterval  10;


// Have slower than 2:1 refinement
nBufferLayers   1;

// Refine cells only up to maxRefinement levels
maxRefinement   10;
minRefineCells  0e-04;

// Stop refinement if maxCells reached
maxCells        150000000;

// Flux field and corresponding velocity field. Fluxes on changed
// faces get recalculated by interpolating the velocity. Use 'none'
// on surfaceScalarFields that do not need to be reinterpolated.
correctFluxes
(
    (phi none)
    (nHatf none)
    (rhoPhi none)
    (alphaPhi none)
    (ghf none)
    (phi0 none)
    (dVf_ none)
    (Kf_  none)
    (alphaPhi_ none)
    (acc_ none)
    (pressureForce none)
    (deltaFunction_ none)
    (nHatf_ none)
    (talphaPhiCorr0_ none)
);

// Write the refinement level as a volScalarField
dumpLevel       true;





