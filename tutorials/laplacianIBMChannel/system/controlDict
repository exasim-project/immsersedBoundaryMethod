FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pisoFoam;
cfdFunctions    (flow);

libs
(
    "dynamicLoadBalanceFvMesh"
    "soIBM"
);

startFrom       startTime; //latestTime;

startTime       0;

stopAt          endTime;

endTime         200;

deltaT          1e-06;

writeControl    adjustableRunTime;

writeInterval   5e-00;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

functions
{
    
}


