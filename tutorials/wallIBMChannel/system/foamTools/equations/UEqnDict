FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      UEqnDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type                    pimpleInterFoam;

field                   U;
velocity                U;
flux                    phi;
pressure                p;

fieldCoeffs             constProperties;
densityField            rho;

equation                (convection diffusion wallIBM);
